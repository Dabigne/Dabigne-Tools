<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Module.MangaDownload.ViewModels.Components"
             x:Class="Module.MangaDownload.Views.Components.ChaptersSelectionView"
             x:DataType="vm:ChaptersSelectionViewModel">
    
    <Grid ColumnDefinitions="*,*,*,*">
        <TextBlock Grid.Column="0"
                   Margin="10"
                   Text="From chapter:"/>
    
        <NumericUpDown Grid.Column="1"
                       Margin="10"
                       FormatString="0"
                       Value="{Binding FirstChapter}"/>
        
        <TextBlock Grid.Column="2"
                   Margin="10"
                   Text="To:"/>
        
        <NumericUpDown Grid.Column="3"
                       Margin="10"
                       FormatString="0"
                       Value="{Binding LastChapter}"/>
    </Grid>
</UserControl>
