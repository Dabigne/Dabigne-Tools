<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Module.MangaDownload.ViewModels"
             xmlns:components="clr-namespace:Module.MangaDownload.Views.Components"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="Module.MangaDownload.Views.MangaDownloadView"
             x:DataType="vm:MangaDownloadViewModel">
    
    <Design.DataContext>
        <vm:DesignTimeMangaDownloadViewModel/>
    </Design.DataContext>

        <Grid Margin="20"
              VerticalAlignment="Center" 
              RowDefinitions="Auto,Auto,Auto,Auto">

            <components:MangaSearchControl Grid.Row="0"
                                           DataContext="{Binding MangaSearch}"/>
            
            <components:ChaptersSelectionView Grid.Row="1"
                                              DataContext="{Binding ChaptersSelection}"/>
            
            <TextBox Grid.Row="2"
                     Margin="10"
                     Text="{Binding NumberOfPagesInImage, Mode=TwoWay}"/>
            
            <Button Grid.Row="3"
                    Foreground="{DynamicResource AccentButtonForeground}"
                    Background="{DynamicResource AccentButtonBackground}"
                    Margin="10,20"
                    Padding="20, 5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Content="Download"
                    Command="{Binding ProcessCommand}"
                    IsEnabled="{Binding CanDownload}"/>
        </Grid>
</UserControl>
