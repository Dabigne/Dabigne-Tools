<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Sizes.axaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <StreamGeometry x:Key="UpArrow">M0,5 L4.5,.5 9,5 6,5 4.5,3.5 3,5 z</StreamGeometry>

    <StreamGeometry x:Key="DownArrow">M0,0 L3,0 4.5,1.5 6,0 9,0 4.5,4.5 z</StreamGeometry>
    
</ResourceDictionary>
