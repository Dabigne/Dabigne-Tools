<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="ExtraSmallIconWidth">8</x:Double>
    <x:Double x:Key="ExtraSmallIconHeight">6</x:Double>

    <x:Double x:Key="ExtraSmallHeight">16</x:Double>
    <x:Double x:Key="SmallHeight">20</x:Double>
    <x:Double x:Key="MediumHeight">28</x:Double>
    <x:Double x:Key="LargeHeight">48</x:Double>
    <x:Double x:Key="ExtraLargeHeight">68</x:Double>
    
    <x:Double x:Key="ExtraSmallPadding">6</x:Double>
    <x:Double x:Key="SmallPadding">8</x:Double>
    <x:Double x:Key="MediumPadding">12</x:Double>
    <x:Double x:Key="LargePadding">24</x:Double>
    <x:Double x:Key="ExtraLargePadding">32</x:Double>
    
    <Thickness x:Key="ExtraSmallSidePadding">6, 0</Thickness>
    <Thickness x:Key="SmallSidePadding">8, 0</Thickness>
    <Thickness x:Key="MediumSidePadding">12, 0</Thickness>
    <Thickness x:Key="LargeSidePadding">24, 0</Thickness>
    <Thickness x:Key="ExtraLargeSidePadding">32, 0</Thickness>
    
    <x:Double x:Key="ExtraSmallMargin">2</x:Double>
    <x:Double x:Key="SmallMargin">4</x:Double>
    <x:Double x:Key="MediumMargin">4</x:Double>
    <x:Double x:Key="LargeMargin">6</x:Double>
    <x:Double x:Key="ExtraLargeMargin">8</x:Double>
    
    <Thickness x:Key="ExtraSmallAllMargin">2</Thickness>
    <Thickness x:Key="SmallAllMargin">4</Thickness>
    <Thickness x:Key="MediumAllMargin">4</Thickness>
    <Thickness x:Key="LargeAllMargin">6</Thickness>
    <Thickness x:Key="ExtraLargeAllMargin">8</Thickness>
    
    <x:Double x:Key="ExtraSmallFontSize">8</x:Double>
    <x:Double x:Key="SmallFontSize">10</x:Double>
    <x:Double x:Key="MediumFontSize">12</x:Double>
    <x:Double x:Key="LargeFontSize">14</x:Double>
    <x:Double x:Key="ExtraLargeFontSize">16</x:Double>

</ResourceDictionary>
