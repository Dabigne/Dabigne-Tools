<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Module.WarhammerTools.Views;assembly=Module.WarhammerTools"
        xmlns:warhammerCompanion="clr-namespace:WarhammerCompanion"
        mc:Ignorable="d" 
        d:DesignWidth="800" 
        d:DesignHeight="450"
        x:Class="WarhammerCompanion.MainWindow"
        x:DataType="warhammerCompanion:MainWindowViewModel"
        Title="Warhammer Companion">
    
    <Design.DataContext>
        <warhammerCompanion:MainWindowViewModel/>
    </Design.DataContext>
    
    <Panel x:Name="Root">
        
    </Panel>

</Window>
