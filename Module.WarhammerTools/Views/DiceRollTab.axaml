<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dice="clr-namespace:Module.WarhammerTools.Models.Dice"
             xmlns:viewModels="clr-namespace:Module.WarhammerTools.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Module.WarhammerTools.Views.DiceRollTab"
             x:DataType="viewModels:DiceRollViewModel">
    
    <Grid ColumnDefinitions="*,220" 
          RowDefinitions="*,Auto" 
          Margin="16">
        
        <!-- 3D Dice Tray -->
        <Border Grid.Row="0" 
                Grid.Column="0" 
                Background="Transparent" 
                CornerRadius="12" 
                ClipToBounds="True">
            <dice:RpgDiceTrayControl
                RollRequest="{Binding CurrentRollRequest}"
                RollResultText="{Binding RollResultText}"
                LastRollTotal="{Binding LastRollTotal}"
                RollCompletedCommand="{Binding RollCompletedCommand}" />
        </Border>

        <!-- Roll History Sidebar -->
        <Border Grid.Row="0" 
                Grid.Column="1" 
                BorderBrush="DarkGoldenrod" 
                BorderThickness="2" 
                CornerRadius="12" 
                Margin="12,0,0,0" 
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Historique des lancers" 
                           FontWeight="Bold" 
                           Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding RollHistory}" Background="Transparent" />
            </DockPanel>
        </Border>

        <!-- Action Bar -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="d4" Command="{Binding RollSingleCommand}" CommandParameter="{x:Static dice:DieType.D4}" />
            <Button Content="d6" Command="{Binding RollSingleCommand}" CommandParameter="{x:Static dice:DieType.D6}" />
            <Button Content="d10" Command="{Binding RollSingleCommand}" CommandParameter="{x:Static dice:DieType.D10}" />
            <Button Content="d12" Command="{Binding RollSingleCommand}" CommandParameter="{x:Static dice:DieType.D12}" />
            <Button Content="d20" Command="{Binding RollSingleCommand}" CommandParameter="{x:Static dice:DieType.D20}" />
            <Button Content="d100 (2d10)" Command="{Binding RollD100Command}" />
            <Button Content="1d20 + 2d6" Command="{Binding RollAttackComboCommand}" />
            <TextBlock Text="{Binding RollResultText}" VerticalAlignment="Center" FontWeight="Bold" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
